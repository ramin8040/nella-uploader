PORT=4000
# For PostgreSQL (Production):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/music_streaming?schema=public"
# For SQLite (Local development):
DATABASE_URL="file:./dev.db"

JWT_SECRET="replace_with_your_super_secret_jwt_key"
JWT_EXPIRES_IN="7d"

# Cloudflare R2 Credentials (S3-compatible)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="music-storage"
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"

# Storage driver: "r2" or "local"
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./uploads"

CORS_ORIGIN="http://localhost:3000"
